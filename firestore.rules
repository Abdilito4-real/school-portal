/**
 * # Firestore Security Rules: Campus Hub
 *
 * ## Core Philosophy
 * This ruleset enforces a security model with two primary user types: Students and Administrators.
 * Students have strict ownership over their personal data (academic results, fees), ensuring privacy.
 * Administrators have broad permissions to manage global data (Classes, Announcements, Student profiles) and view student-specific data for administrative purposes.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper Functions
    // -------------------------------------------------------------------------

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isBootstrapAdmin() {
      return isSignedIn() && request.auth.token.email == 'admin@example.com';
    }

    function getAdminData() {
      return get(/databases/$(database)/documents/roles_admin/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isBootstrapAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) && getAdminData().get('isSuperAdmin', false) == true);
    }

    function isAuthorizedAdmin() {
      return isBootstrapAdmin() || exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid));
    }

    function isAdminOfClass(classId) {
      return isSuperAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/roles_admin/$(request.auth.uid)) &&
        classId in getAdminData().get('classIds', [])
      );
    }

    function isCreatingOwnStudentData(userId) {
      return request.resource.data.studentId == userId;
    }

    function studentIdIsImmutable() {
      return request.resource.data.studentId == resource.data.studentId;
    }

    function canReadAnnouncement(announcement) {
      let studentClassId = get(/databases/$(database)/documents/students/$(request.auth.uid)).data.classId;
      return studentClassId in announcement.data.classIds;
    }

    // -------------------------------------------------------------------------
    // User-Private Collections
    // -------------------------------------------------------------------------

    match /users/{userId}/academicResults/{academicResultId} {
      allow get, list: if isOwner(userId) || isAuthorizedAdmin();
      allow create, update, delete: if isSuperAdmin() || (isAuthorizedAdmin() && isAdminOfClass(get(/databases/$(database)/documents/students/$(userId)).data.classId));
    }

    match /users/{userId}/fees/{feeId} {
      allow get, list: if isOwner(userId) || isAuthorizedAdmin();
      allow create, update, delete: if isSuperAdmin() || (isAuthorizedAdmin() && isAdminOfClass(get(/databases/$(database)/documents/students/$(userId)).data.classId));
    }

    // -------------------------------------------------------------------------
    // Global & Administrative Collections
    // -------------------------------------------------------------------------

    match /roles_admin/{userId} {
      allow get: if isSignedIn();
      allow list: if isSuperAdmin();
      allow create: if isSuperAdmin() || (isOwner(userId) && isBootstrapAdmin());
      allow update, delete: if isSuperAdmin();
    }

    match /students/{studentId} {
      allow get: if isOwner(studentId) || isAuthorizedAdmin();
      allow list: if isAuthorizedAdmin();
      allow create: if isAdminOfClass(request.resource.data.classId);
      allow update: if isAdminOfClass(resource.data.classId) && isAdminOfClass(request.resource.data.classId);
      allow delete: if isAdminOfClass(resource.data.classId);
    }

    match /classes/{classId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin();
    }

    match /announcements/{announcementId} {
      allow get: if isAuthorizedAdmin() || (isSignedIn() && canReadAnnouncement(resource));
      allow list: if isSignedIn();
      allow create: if isSuperAdmin() || (isAuthorizedAdmin() && request.resource.data.classIds.hasOnly(getAdminData().get('classIds', [])));
      allow update: if isSuperAdmin() || (isAuthorizedAdmin() && resource.data.classIds.hasOnly(getAdminData().get('classIds', [])) && request.resource.data.classIds.hasOnly(getAdminData().get('classIds', [])));
      allow delete: if isSuperAdmin() || (isAuthorizedAdmin() && resource.data.classIds.hasOnly(getAdminData().get('classIds', [])));
    }
    
    match /site_content/{contentId} {
      allow read;
      allow write: if isSuperAdmin();
    }

    match /fees/{feeId} {
      allow read: if isAuthorizedAdmin();
      allow create, update: if isSuperAdmin() || (isAuthorizedAdmin() && isAdminOfClass(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.classId));
      allow delete: if isSuperAdmin() || (isAuthorizedAdmin() && isAdminOfClass(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.classId));
    }

    match /academicResults/{resultId} {
      allow read: if isAuthorizedAdmin();
      allow create, update: if isSuperAdmin() || (isAuthorizedAdmin() && isAdminOfClass(get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.classId));
      allow delete: if isSuperAdmin() || (isAuthorizedAdmin() && isAdminOfClass(get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.classId));
    }
  }
}
